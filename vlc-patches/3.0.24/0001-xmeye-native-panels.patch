+static QSpinBox *xmeyeSpin( int minv, int maxv, int value, QWidget *parent,
+                            const QString &suffix = QString() )
+{
+    QSpinBox *s = new QSpinBox( parent );
+    s->setRange( minv, maxv );
+    s->setValue( value );
+    if( !suffix.isEmpty() ) s->setSuffix( suffix );
+    return s;
+}

+class XMEyeZoomScale : public QWidget
+{
+public:
+    explicit XMEyeZoomScale(QWidget *parent=nullptr):QWidget(parent)
+    {
+        setMinimumHeight(70);
+        setSizePolicy(QSizePolicy::Expanding,QSizePolicy::Fixed);
+    }
+    void setValue(int v){ value=qBound(100,v,800); update(); }
+    void setCallback(const std::function<void(int)> &cb){ changed=cb; }
+protected:
+    void paintEvent(QPaintEvent*) override
+    {
+        QPainter p(this); p.setRenderHint(QPainter::Antialiasing,true);
+        QRectF area=rect().adjusted(14,14,-14,-24);
+        QLinearGradient gr(area.topLeft(),area.topRight());
+        gr.setColorAt(0.0,QColor(40,40,40)); gr.setColorAt(0.5,QColor(135,135,135)); gr.setColorAt(1.0,QColor(235,235,235));
+        p.setPen(QPen(palette().mid().color(),1)); p.setBrush(gr); p.drawRoundedRect(area,6,6);
+        const double f=(value-100)/700.0; const double x=area.left()+area.width()*f;
+        p.setPen(QPen(QColor(255,255,255),3)); p.drawLine(QPointF(x,area.top()-5),QPointF(x,area.bottom()+5));
+        p.setPen(palette().text().color());
+        p.drawText(QRectF(0,height()-22,width(),20),Qt::AlignCenter,QString("Zoom %1%   (100%–800%)").arg(value));
+    }
+    void mousePressEvent(QMouseEvent *e) override {setFromPoint(e->pos());}
+    void mouseMoveEvent(QMouseEvent *e) override {if(e->buttons()&Qt::LeftButton)setFromPoint(e->pos());}
+private:
+    void setFromPoint(const QPoint &pt)
+    {
+        QRectF area=rect().adjusted(14,14,-14,-24);
+        const double f=qBound(0.0,(pt.x()-area.left())/area.width(),1.0);
+        value=qRound(100.0+700.0*f); update(); if(changed)changed(value);
+    }
+    int value=200; std::function<void(int)> changed;
+};

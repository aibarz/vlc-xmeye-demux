+/* XMEye native panels — original concept and functional design: Álvaro Ibarz */
+static QString xmeyeVideoFilterChain( intf_thread_t *p_intf )
+{
+    char *raw = var_GetString( THEPL, "video-filter" );
+    QString chain = qfu( raw ? raw : "" );
+    free( raw );
+    return chain;
+}
+
+static bool xmeyeFilterEnabled( intf_thread_t *p_intf, const char *name )
+{
+    QStringList list = xmeyeVideoFilterChain( p_intf ).split( ':' );
+    list.removeAll( QString() );
+    return list.contains( qfu( name ) );
+}
+
+static void xmeyeSetFilterEnabled( intf_thread_t *p_intf, const char *name, bool enabled )
+{
+    QStringList list = xmeyeVideoFilterChain( p_intf ).split( ':' );
+    list.removeAll( QString() );
+    const QString module = qfu( name );
+    if( enabled && !list.contains( module ) ) list << module;
+    if( !enabled ) list.removeAll( module );
+    const QByteArray chain = list.join( ":" ).toUtf8();
+    var_SetString( THEPL, "video-filter", chain.constData() );
+
+    QVector<vout_thread_t*> vouts = THEMIM->getVouts();
+    foreach( vout_thread_t *vout, vouts )
+    {
+        var_SetString( vout, "video-filter", chain.constData() );
+        vlc_object_release( vout );
+    }
+    VLC_UNUSED( p_intf );
+}
+
+static void xmeyeSetOption( intf_thread_t *p_intf, const char *module,
+                            const char *option, int value, bool isBool = false )
+{
+    const int type = isBool ? VLC_VAR_BOOL : VLC_VAR_INTEGER;
+    vlc_value_t val;
+    if( isBool ) val.b_bool = value != 0;
+    else val.i_int = value;
+
+    var_Create( THEPL, option, type | VLC_VAR_DOINHERIT );
+    var_SetChecked( THEPL, option, type, val );
+
+    QVector<vout_thread_t*> vouts = THEMIM->getVouts();
+    foreach( vout_thread_t *vout, vouts )
+    {
+        var_Create( vout, option, type | VLC_VAR_DOINHERIT | VLC_VAR_ISCOMMAND );
+        var_SetChecked( vout, option, type, val );
+        vlc_object_release( vout );
+    }
+
+    vlc_object_t *obj = (vlc_object_t*)vlc_object_find_name( THEPL, module );
+    if( obj )
+    {
+        if( var_Type( obj, option ) != 0 )
+            var_SetChecked( obj, option, type, val );
+        vlc_object_release( obj );
+    }
+    VLC_UNUSED( p_intf );
+}

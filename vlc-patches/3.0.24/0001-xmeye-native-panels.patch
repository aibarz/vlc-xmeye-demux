+        const QPointF actualCenter=roi.center(); p.setPen(QPen(QColor(255,255,255),3)); p.drawRect(roi); p.drawLine(QPointF(actualCenter.x()-10,actualCenter.y()),QPointF(actualCenter.x()+10,actualCenter.y())); p.drawLine(QPointF(actualCenter.x(),actualCenter.y()-10),QPointF(actualCenter.x(),actualCenter.y()+10)); p.setPen(palette().text().color()); p.drawText(QRectF(10,height()-24,width()-20,20),Qt::AlignCenter,QString("%1%   X %2%   Y %3%").arg(zoom).arg(cx).arg(cy));
